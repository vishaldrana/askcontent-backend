# Two URLs, two ports, and the difference matters.
#
# 5432 is the DIRECT connection. 6543 is pgbouncer in transaction mode.
# DDL, advisory locks and CREATE EXTENSION do not survive a transaction pooler,
# so migrations must use the direct URL. The application uses the pooled one.
ASKCONTENT_DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
ASKCONTENT_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# Our tables live here, pinned through the ORM metadata (ARC-TEC-05).
# Never set a search_path option on the connection string instead: poolers drop
# that startup parameter and the tables land in `public`.
ASKCONTENT_DB_SCHEMA=askcontent

ASKCONTENT_MULTI_TENANT=false
ASKCONTENT_RERANKER=auto
ASKCONTENT_ENCRYPTION_KEY=replace-me
