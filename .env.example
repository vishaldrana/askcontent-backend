# askcontent-backend — every environment knob, with its default and its trap.
#
# Copy to `.env` and fill in the placeholders. Everything here maps 1:1 onto
# `src/askcontent/config.py` (pydantic-settings, prefix ASKCONTENT_); a
# variable left unset simply keeps the default shown in the comment. The app
# also runs with NOTHING set: no database means mock PGP/ECM adapters, no API
# key means the deterministic offline embedder and extractive answerer — which
# is exactly what the 212-test offline suite uses.
#
# `.env` is gitignored. Never commit real values of anything marked (secret).

# ---------------------------------------------------------------------------
# Database — read this block before touching the URLs
# ---------------------------------------------------------------------------
# On Supabase, both URLs must point at the POOLER host, not the direct host:
#
#   * the direct host `db.<ref>.supabase.co` is IPv6-only and does not resolve
#     from an IPv4 network at all — it is not slower, it is absent
#   * the pooler host is `aws-1-<region>.pooler.supabase.com` — note `aws-1`,
#     not the `aws-0` older docs show
#   * port 5432 on the pooler = SESSION mode: what DDL, CREATE EXTENSION and
#     alembic migrations need
#   * port 6543 on the pooler = TRANSACTION mode: fine for the application,
#     never for migrations
#
# Two more traps that cost real time:
#   * `?options=-csearch_path=...` on the DSN is SILENTLY DROPPED by Supavisor.
#     The schema is pinned by the app itself (a connect listener issues
#     SET search_path) — do not try to do it here.
#   * pgvector lives in the `extensions` schema on Supabase; the app puts it on
#     the search_path for you.
#
# The username on the pooler is `postgres.<project-ref>`, not `postgres`.
ASKCONTENT_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Where migrations run. Defaults to ASKCONTENT_DATABASE_URL when unset; set it
# separately only if the app runs on 6543 (transaction mode) — migrations still
# need 5432 (session mode).
ASKCONTENT_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Our schema on a genuinely shared database (askdb, intelligence, langgraph
# and others live beside us). Every application table inside it is further
# prefixed `askcontent_` (migration 0025), so a bare table name in a log or
# dashboard still says who owns it. Default: askcontent
ASKCONTENT_DB_SCHEMA=askcontent

# Pool arithmetic on a SHARED pooler: N services × (size + overflow) must stay
# under the project's connection ceiling, and the ceiling belongs to whoever
# hits it last. Stay small. Defaults: 3 and 2.
ASKCONTENT_POOL_SIZE=3
ASKCONTENT_POOL_MAX_OVERFLOW=2

# Ceiling for any single statement. Set by the app's connect listener, not the
# DSN, for the same Supavisor reason as search_path. Default: 15000
ASKCONTENT_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Multi-tenancy (PLT-TEN)
# ---------------------------------------------------------------------------
# false = single-team deployment: every request binds to the one database
# above and the control plane is unused. true = tenants resolve through the
# control-plane database (a SEPARATE database, its own alembic history under
# migrations_control/). Both shapes are the same code path. Default: false
ASKCONTENT_MULTI_TENANT=false
# Only read when multi_tenant=true.
#ASKCONTENT_CONTROL_PLANE_URL=postgresql+psycopg://...

# ---------------------------------------------------------------------------
# Providers — generation and embedding configured independently (ARC-TEC-14),
# because they are routinely different vendors. Same triple askdb uses.
# ---------------------------------------------------------------------------
# "auto" = use the real model when its key is present, else the offline
# stand-in. The offline embedder (hashed n-gram bag) is right for tests and
# materially worse for retrieval: it only matches documents that repeat the
# words of the question. Defaults: auto / text-embedding-3-small / 1536
ASKCONTENT_EMBEDDING_PROVIDER=auto
ASKCONTENT_EMBEDDING_MODEL=text-embedding-3-small
ASKCONTENT_EMBEDDING_DIM=1536
# (secret)
ASKCONTENT_EMBEDDING_API_KEY=

# "auto" = model when a key is present, extractive stand-in when not;
# "extractive" forces offline answers. Defaults: auto / gpt-4.1-2025-04-14
ASKCONTENT_LLM_PROVIDER=auto
ASKCONTENT_LLM_MODEL=gpt-4.1-2025-04-14
# (secret)
ASKCONTENT_LLM_API_KEY=
# For OpenAI-compatible gateways; leave unset for the vendor default.
#ASKCONTENT_LLM_BASE_URL=

# Reranker. "auto" picks cross-encoder when sentence-transformers is
# installed (the `rerank` extra), else the deterministic lexical reranker.
# Model choice is a size decision: bge-reranker-v2-m3 is stronger and
# multilingual but a 2.2 GB download; MiniLM (~90 MB, English-only) measures
# ~190 ms for 24 pairs on an M-series laptop. Whichever is chosen must already
# be in the image — a reranker that fetches weights on first request fails as
# a latency spike. Defaults: auto / BAAI/bge-reranker-v2-m3
ASKCONTENT_RERANKER=auto
ASKCONTENT_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---------------------------------------------------------------------------
# Retrieval defaults — platform-wide, per-connector overridable; the console
# shows which of the two an effective value came from (CNT-ADM-20). The
# defaults are considered choices; override per deployment only with a reason.
# ---------------------------------------------------------------------------
#ASKCONTENT_K_PER_CHANNEL=20            # candidates per retrieval channel
#ASKCONTENT_RRF_CONSTANT=60             # reciprocal-rank-fusion damping
#ASKCONTENT_RERANK_FLOOR=0.08           # below this score a passage is dropped
#ASKCONTENT_MAX_RERANK_PAIRS=100        # rerank cost ceiling per question
#ASKCONTENT_PASSAGES_PER_DOCUMENT=3     # diversity: no document dominates
#ASKCONTENT_CONTEXT_BUDGET_CHUNKS=12    # chunks handed to the answerer
#ASKCONTENT_CHANNEL_TIMEOUT_SECONDS=3.0 # a slow channel is skipped, not waited on
#ASKCONTENT_FETCH_TIMEOUT_SECONDS=5.0   # per-document fetch from the ECM
# Share of a question's content words that must appear in retrieved passages
# before an answer is attempted; below it the system declines rather than
# guesses (see domain/groundedness.py). Default: 0.34
#ASKCONTENT_RELEVANCE_FLOOR=0.34

# ---------------------------------------------------------------------------
# External systems — PGP (the company vector index) and the ECM (the system
# of record). Neither is reachable from here yet, so unset means the detailed
# behavioural mocks; each mock method's docstring names the real call that
# replaces it.
# ---------------------------------------------------------------------------
#ASKCONTENT_PGP_BASE_URL=
#ASKCONTENT_ECM_BASE_URL=

# ---------------------------------------------------------------------------
# Secrets at rest
# ---------------------------------------------------------------------------
# Envelope-encryption root key for stored credentials. Rotates independently
# of the control plane's connection-string key (PLT-TEN-05). The default is
# deliberately unusable in production. (secret)
ASKCONTENT_ENCRYPTION_KEY=replace-me
